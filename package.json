{
  "name": "tapo-admin",
  "version": "0.2.0",
  "description": "Multi-camera live view, PTZ, two-way audio, and SD archive viewer for TP-Link Tapo cameras via Electrobun desktop or Docker.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/dev.ts",
    "dev:emulator": "TAPO_DEBUG_EMULATOR=true bun --hot src/server/dev.ts",
    "start": "bun src/server/index.ts",
    "build:client": "bun run scripts/build-client.ts",
    "desktop:dev": "bunx electrobun dev",
    "desktop:build": "bunx electrobun build --env=stable",
    "desktop:build:dev": "bunx electrobun build",
    "icons:generate": "bun run scripts/generate-icons.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "mediabunny": "^1.66.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "bun-plugin-tailwind": "^0.1.2",
    "electrobun": "^2.0.7",
    "typescript": "^5.9.3"
  }
}
