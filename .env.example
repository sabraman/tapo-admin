# HTTP server bind address and port
# Use 127.0.0.1 for local-only access, or 0.0.0.0 inside Docker / behind a reverse proxy.
HOST=127.0.0.1
PORT=3456

# Directory for persisted Tapo session, camera/store metadata, settings, snapshots, and clips
TAPO_DATA_DIR=.data

# Optional shared password protecting the web UI, REST API, and WebSockets when exposed remotely.
# Leave empty to disable the access lock screen (default for localhost / desktop app).
TAPO_ACCESS_PASSWORD=

# Enable built-in mock cameras for UI development without physical Tapo hardware (true/false)
TAPO_DEBUG_EMULATOR=false

# Path or binary name for FFmpeg (required for MJPEG fallback, fMP4, MP3 audio, clips, and SD playback)
FFMPEG_PATH=ffmpeg

# Path to Tapo Cloud root CA bundle
TAPO_CERT_PATH=certs/tapo-cloud-roots.pem
